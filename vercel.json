{
  "rewrites": [
    {
      "source": "/post/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Twitterbot|WhatsApp|facebookexternalhit|TelegramBot|LinkedInBot|Slackbot|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/post/:id",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}